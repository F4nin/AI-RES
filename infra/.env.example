# Optional, NON-SECRET overrides for `docker compose` (copy to .env; .env is git-ignored). Secrets never go here: they are Compose secrets
# generated by `make secrets-dev` (SOPS/age) and mounted as files.
# Temporal namespace retention for `ai-res` (WORKING dev default 72h, OD-02).
# AI_RES_TEMPORAL_RETENTION=72h

FROM ghcr.io/astral-sh/uv:0.11.0@sha256:e49fde5daf002023f0a2e2643861ce9ca8a8da5b73d0e6db83ef82ff99969baf AS uv
FROM python:3.13.18-slim-bookworm@sha256:1cbf5090b131eace73aff87e4e5d3d27900ee5ffbe8d61fa2ede4bd6e231c7cf
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock ./
ENV UV_LOCKED=1 UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy PATH=/app/.venv/bin:$PATH PYTHONUNBUFFERED=1
RUN uv sync --locked --no-install-project
USER 1000:1000

new file mode 100644
--- /dev/null
+++ b/core/providers/openai/chat_stream_metadata.go
@@ -0,0 +1,58 @@
+package openai
+
+import (
+	"context"
+	providerUtils "github.com/maximhq/bifrost/core/providers/utils"
+	"github.com/maximhq/bifrost/core/schemas"
+)
+
+func guardFlashNativeChatMetadata(ctx *schemas.BifrostContext, provider schemas.ModelProvider, request *schemas.BifrostChatRequest, responsesFallback bool) bool {
+	return !responsesFallback && ctx.Value(schemas.BifrostContextKeyIntegrationType) == nil && provider == schemas.DeepSeek && request.Provider == schemas.DeepSeek && request.Model == "deepseek-flash"
+}
+
+func newFlashMetadataFailure(ctx *schemas.BifrostContext) *schemas.BifrostError {
+	failure := providerUtils.NewBifrostOperationError("chat stream metadata validation failed", nil)
+	failure.AllowFallbacks = schemas.Ptr(false)
+	ctx.SetValue(schemas.BifrostContextKeyStreamEndIndicator, true)
+	// Rejecting an upstream must abandon it, not drain an unbounded remainder or
+	// return a half-read connection to the pool. Reuse the existing no-drain path.
+	ctx.SetValue(schemas.BifrostContextKeyStreamParkedAfterFinish, true)
+	return failure
+}
+
+func rejectFlashChatMetadata(ctx *schemas.BifrostContext, hooks schemas.PostHookRunner, output chan *schemas.BifrostStreamChunk, logger schemas.Logger, finalizer func(context.Context)) {
+	// Notify normal hooks, but they cannot rewrite/drop this integrity refusal or
+	// attach raw metadata. Return a fresh error even if a hook mutates its input.
+	refusalHooks := func(c *schemas.BifrostContext, _ *schemas.BifrostResponse, _ *schemas.BifrostError) (*schemas.BifrostResponse, *schemas.BifrostError) {
+		hooks(c, nil, newFlashMetadataFailure(c))
+		return nil, newFlashMetadataFailure(c)
+	}
+	providerUtils.ProcessAndSendBifrostError(ctx, refusalHooks, newFlashMetadataFailure(ctx), output, logger, finalizer)
+}
+
+func checkedFlashChatPostHooks(hooks schemas.PostHookRunner, rejected *bool) schemas.PostHookRunner {
+	return func(ctx *schemas.BifrostContext, input *schemas.BifrostResponse, incoming *schemas.BifrostError) (*schemas.BifrostResponse, *schemas.BifrostError) {
+		if *rejected || incoming != nil || !exclusiveFlashChatResponse(input) {
+			*rejected = true
+			return nil, newFlashMetadataFailure(ctx)
+		}
+		expected, seen := input.ChatResponse.ObservedChatStreamMetadata()
+		if !seen || !input.ChatResponse.MatchesObservedChatStreamMetadata(expected) {
+			*rejected = true
+			return nil, newFlashMetadataFailure(ctx)
+		}
+		output, failure := hooks(ctx, input, nil)
+		if failure != nil || !exclusiveFlashChatResponse(output) || !output.ChatResponse.MatchesObservedChatStreamMetadata(expected) {
+			*rejected = true
+			return nil, newFlashMetadataFailure(ctx)
+		}
+		return output, nil
+	}
+}
+
+// Every pinned response field is a pointer. Exact equality excludes all other
+// families without reflection; a future non-comparable schema fails to compile
+// rather than silently broadening the guarded wire variant.
+func exclusiveFlashChatResponse(response *schemas.BifrostResponse) bool {
+	return response != nil && response.ChatResponse != nil && *response == (schemas.BifrostResponse{ChatResponse: response.ChatResponse})
+}
diff --git a/core/providers/openai/chat_stream_metadata_scope_test.go b/core/providers/openai/chat_stream_metadata_scope_test.go
new file mode 100644
--- /dev/null
+++ b/core/providers/openai/chat_stream_metadata_scope_test.go
@@ -0,0 +1,166 @@
+package openai
+
+import (
+	"context"
+	"reflect"
+	"testing"
+
+	"github.com/maximhq/bifrost/core/schemas"
+)
+
+func TestFlashMetadataGuardScope(t *testing.T) {
+	request := &schemas.BifrostChatRequest{Provider: schemas.DeepSeek, Model: "deepseek-flash"}
+	ctx := schemas.NewBifrostContext(context.Background(), schemas.NoDeadline)
+	if !guardFlashNativeChatMetadata(ctx, schemas.DeepSeek, request, false) {
+		t.Fatal("native Flash not guarded")
+	}
+	if guardFlashNativeChatMetadata(ctx, schemas.DeepSeek, request, true) {
+		t.Fatal("responses fallback changed")
+	}
+	ctx.SetValue(schemas.BifrostContextKeyIntegrationType, "openai")
+	if guardFlashNativeChatMetadata(ctx, schemas.DeepSeek, request, false) {
+		t.Fatal("compat integration changed")
+	}
+	for _, request := range []*schemas.BifrostChatRequest{{Provider: schemas.DeepSeek, Model: "deepseek-v4-pro"}, {Provider: schemas.OpenAI, Model: "deepseek-flash"}} {
+		own := schemas.NewBifrostContext(context.Background(), schemas.NoDeadline)
+		if guardFlashNativeChatMetadata(own, request.Provider, request, false) {
+			t.Fatal("unrelated profile changed")
+		}
+	}
+}
+
+func assertFlashIntegrityRefusal(t *testing.T, chunks []*schemas.BifrostStreamChunk, hits int32, abandoned bool) {
+	t.Helper()
+	if hits != 1 || !abandoned {
+		t.Fatal("integrity refusal did not stop upstream")
+	}
+	failed := false
+	for _, chunk := range chunks {
+		value := reflect.ValueOf(chunk).Elem()
+		for i := 0; i < value.NumField(); i++ {
+			name := value.Type().Field(i).Name
+			if name != "BifrostChatResponse" && name != "BifrostError" && !value.Field(i).IsNil() {
+				t.Fatal("forged mixed family exported")
+			}
+		}
+		if chunk.BifrostChatResponse != nil && chunk.BifrostChatResponse.Usage != nil {
+			t.Fatal("successful terminal after integrity refusal")
+		}
+		if chunk.BifrostError != nil {
+			failed = true
+			e := chunk.BifrostError
+			if e.AllowFallbacks == nil || *e.AllowFallbacks || !e.IsBifrostError || e.Error.Message != "chat stream metadata validation failed" || e.Error.Error != nil || e.StreamControl != nil {
+				t.Fatal("metadata refusal changed or dropped")
+			}
+		}
+	}
+	if !failed {
+		t.Fatal("missing controlled refusal")
+	}
+}
+
+func TestFlashMetadataHooksAndConvertersCannotReplaceObservedFacts(t *testing.T) {
+	meta := `,"system_fingerprint":"fp-A"`
+	frames := []string{flashFrame(meta, flashContent, ""), flashFrame(meta, flashFinish, ""), flashFrame(meta, "[]", flashUsage)}
+	for _, mode := range []string{"id", "model", "fingerprint", "replacement", "new-observation", "drop", "skip", "mixed-text"} {
+		t.Run("hook-"+mode, func(t *testing.T) {
+			hooks := func(_ *schemas.BifrostContext, r *schemas.BifrostResponse, e *schemas.BifrostError) (*schemas.BifrostResponse, *schemas.BifrostError) {
+				if e != nil {
+					return r, e
+				}
+				switch mode {
+				case "id":
+					r.ChatResponse.ID = "changed"
+				case "model":
+					r.ChatResponse.Model = "changed"
+				case "fingerprint":
+					r.ChatResponse.SystemFingerprint = "changed"
+				case "replacement":
+					r = &schemas.BifrostResponse{ChatResponse: &schemas.BifrostChatResponse{ID: "c", Model: "deepseek-flash", SystemFingerprint: "fp-A"}}
+				case "new-observation":
+					var own schemas.ChatStreamMetadataTracker
+					fact, _ := own.Observe([]byte(`{"id":"changed","model":"deepseek-flash","system_fingerprint":"fp-A"}`))
+					r.ChatResponse.SetObservedChatStreamMetadata(fact)
+				case "drop":
+					return nil, nil
+				case "mixed-text":
+					r.TextCompletionResponse = &schemas.BifrostTextCompletionResponse{ID: "forged", Model: "forged", Object: "chat.completion.chunk", Choices: r.ChatResponse.Choices}
+				case "skip":
+					return nil, &schemas.BifrostError{StreamControl: &schemas.StreamControl{SkipStream: schemas.Ptr(true)}}
+				}
+				return r, nil
+			}
+			chunks, hits, closed := runFlashMetadataStreamWithHooks(t, frames, true, hooks, nil)
+			assertFlashIntegrityRefusal(t, chunks, hits, closed)
+		})
+	}
+	for _, mode := range []string{"mutation", "replacement", "nil", "terminal-replacement"} {
+		t.Run("converter-"+mode, func(t *testing.T) {
+			converter := func(r *schemas.BifrostChatResponse) *schemas.BifrostChatResponse {
+				switch mode {
+				case "mutation":
+					r.Model = "changed"
+					return r
+				case "replacement":
+					return &schemas.BifrostChatResponse{ID: r.ID, Model: r.Model, SystemFingerprint: r.SystemFingerprint}
+				case "nil":
+					return nil
+				case "terminal-replacement":
+					if r.Usage != nil && len(r.Choices) > 0 {
+						return &schemas.BifrostChatResponse{ID: r.ID, Model: r.Model, SystemFingerprint: r.SystemFingerprint, Usage: r.Usage, Choices: r.Choices}
+					}
+				}
+				return r
+			}
+			chunks, hits, closed := runFlashMetadataStreamWithHooks(t, frames, true, nil, converter)
+			assertFlashIntegrityRefusal(t, chunks, hits, closed)
+		})
+	}
+}
+
+func TestFlashMetadataRefusalCannotBeRewrittenOrSkippedByHooks(t *testing.T) {
+	for _, mode := range []string{"success", "drop", "skip", "mutate-error"} {
+		t.Run(mode, func(t *testing.T) {
+			hooks := func(_ *schemas.BifrostContext, r *schemas.BifrostResponse, e *schemas.BifrostError) (*schemas.BifrostResponse, *schemas.BifrostError) {
+				if e == nil {
+					return r, nil
+				}
+				switch mode {
+				case "success":
+					return &schemas.BifrostResponse{ChatResponse: &schemas.BifrostChatResponse{ID: "c", Model: "deepseek-flash"}}, nil
+				case "drop":
+					return nil, nil
+				case "skip":
+					return nil, &schemas.BifrostError{StreamControl: &schemas.StreamControl{SkipStream: schemas.Ptr(true)}}
+				case "mutate-error":
+					e.Error.Message = "private metadata"
+					e.AllowFallbacks = schemas.Ptr(true)
+					return nil, e
+				}
+				return r, e
+			}
+			chunks, hits, closed := runFlashMetadataStreamWithHooks(t, []string{`{"id":"c"`}, true, hooks, nil)
+			assertFlashIntegrityRefusal(t, chunks, hits, closed)
+		})
+	}
+}
+
+func TestFlashMetadataRejectsEveryMixedResponseFamily(t *testing.T) {
+	kind := reflect.TypeOf(schemas.BifrostResponse{})
+	for i := 0; i < kind.NumField(); i++ {
+		field := kind.Field(i)
+		if field.Name == "ChatResponse" {
+			continue
+		}
+		t.Run(field.Name, func(t *testing.T) {
+			hooks := func(_ *schemas.BifrostContext, r *schemas.BifrostResponse, e *schemas.BifrostError) (*schemas.BifrostResponse, *schemas.BifrostError) {
+				if e == nil {
+					reflect.ValueOf(r).Elem().FieldByName(field.Name).Set(reflect.New(field.Type.Elem()))
+				}
+				return r, e
+			}
+			chunks, hits, closed := runFlashMetadataStreamWithHooks(t, []string{flashFrame(`,"system_fingerprint":"fp-A"`, flashContent, "")}, true, hooks, nil)
+			assertFlashIntegrityRefusal(t, chunks, hits, closed)
+		})
+	}
+}
diff --git a/core/providers/openai/chat_stream_metadata_test.go b/core/providers/openai/chat_stream_metadata_test.go
new file mode 100644
--- /dev/null
+++ b/core/providers/openai/chat_stream_metadata_test.go
@@ -0,0 +1,199 @@
+package openai
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/maximhq/bifrost/core/schemas"
+	"github.com/valyala/fasthttp"
+)
+
+type flashMetadataLogger struct{}
+
+func (flashMetadataLogger) Debug(string, ...any)                   {}
+func (flashMetadataLogger) Info(string, ...any)                    {}
+func (flashMetadataLogger) Warn(string, ...any)                    {}
+func (flashMetadataLogger) Error(string, ...any)                   {}
+func (flashMetadataLogger) Fatal(string, ...any)                   {}
+func (flashMetadataLogger) SetLevel(schemas.LogLevel)              {}
+func (flashMetadataLogger) SetOutputType(schemas.LoggerOutputType) {}
+func (flashMetadataLogger) LogHTTPRequest(schemas.LogLevel, string) schemas.LogEventBuilder {
+	return schemas.NoopLogEvent
+}
+
+func flashFrame(meta, choices, usage string) string {
+	if usage == "" {
+		usage = "null"
+	}
+	return `{"id":"c","model":"deepseek-flash","object":"chat.completion.chunk","created":1` + meta + `,"choices":` + choices + `,"usage":` + usage + `}`
+}
+
+const flashContent = `[{"index":0,"delta":{"content":"OK"},"finish_reason":null}]`
+const flashFinish = `[{"index":0,"delta":{},"finish_reason":"stop"}]`
+const flashUsage = `{"prompt_tokens":0,"completion_tokens":0,"total_tokens":0}`
+
+func runFlashMetadataStream(t *testing.T, frames []string, park bool) ([]*schemas.BifrostStreamChunk, int32, bool) {
+	t.Helper()
+	return runFlashMetadataStreamWithHooks(t, frames, park, nil, nil)
+}
+
+func runFlashMetadataStreamWithHooks(t *testing.T, frames []string, park bool, customHooks schemas.PostHookRunner, converter func(*schemas.BifrostChatResponse) *schemas.BifrostChatResponse) ([]*schemas.BifrostStreamChunk, int32, bool) {
+	t.Helper()
+	var hits atomic.Int32
+	closed := make(chan struct{}, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		hits.Add(1)
+		w.Header().Set("Content-Type", "text/event-stream")
+		for _, frame := range frames {
+			if _, err := fmt.Fprintf(w, "data: %s\n\n", frame); err != nil {
+				return
+			}
+			w.(http.Flusher).Flush()
+		}
+		if park {
+			select {
+			case <-r.Context().Done():
+				closed <- struct{}{}
+			case <-time.After(2 * time.Second):
+			}
+			return
+		}
+		_, _ = fmt.Fprint(w, "data: [DONE]\n\n")
+	}))
+	defer server.Close()
+	ctx, cancel := schemas.NewBifrostContextWithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	request := &schemas.BifrostChatRequest{Provider: schemas.DeepSeek, Model: "deepseek-flash", Input: []schemas.ChatMessage{{Role: schemas.ChatMessageRoleUser, Content: &schemas.ChatMessageContent{ContentStr: schemas.Ptr("synthetic")}}}}
+	hook := func(_ *schemas.BifrostContext, r *schemas.BifrostResponse, e *schemas.BifrostError) (*schemas.BifrostResponse, *schemas.BifrostError) {
+		return r, e
+	}
+	if customHooks != nil {
+		hook = customHooks
+	}
+	output, failure := HandleOpenAIChatCompletionStreaming(ctx, &fasthttp.Client{}, server.URL, request, nil, nil, 1, false, false, schemas.DeepSeek, hook, nil, nil, nil, nil, converter, nil, flashMetadataLogger{}, nil)
+	if failure != nil {
+		t.Fatalf("stream creation failed: %s", failure.Error.Message)
+	}
+	var chunks []*schemas.BifrostStreamChunk
+	for chunk := range output {
+		chunks = append(chunks, chunk)
+	}
+	abandoned := false
+	if park {
+		select {
+		case <-closed:
+			abandoned = true
+		case <-time.After(100 * time.Millisecond):
+		}
+	}
+	return chunks, hits.Load(), abandoned
+}
+
+func TestFlashNativeStreamPreservesEveryPresenceAndZeroUsage(t *testing.T) {
+	for _, meta := range []string{"", `,"system_fingerprint":null`, `,"system_fingerprint":"fp-A"`} {
+		t.Run(meta, func(t *testing.T) {
+			chunks, hits, _ := runFlashMetadataStream(t, []string{flashFrame(meta, flashContent, ""), flashFrame(meta, flashFinish, ""), flashFrame(meta, "[]", flashUsage)}, false)
+			if hits != 1 || len(chunks) < 2 {
+				t.Fatal("missing chunks or repeated request")
+			}
+			terminal := false
+			for _, chunk := range chunks {
+				if chunk.BifrostError != nil {
+					t.Fatal("stable metadata refused")
+				}
+				wire, err := json.Marshal(chunk)
+				if err != nil {
+					t.Fatal(err)
+				}
+				var obj map[string]json.RawMessage
+				if json.Unmarshal(wire, &obj) != nil {
+					t.Fatal("invalid wire")
+				}
+				want := map[string]string{"": "", `,"system_fingerprint":null`: "null", `,"system_fingerprint":"fp-A"`: `"fp-A"`}[meta]
+				if string(obj["system_fingerprint"]) != want {
+					t.Fatalf("fingerprint state changed: %s", wire)
+				}
+				if chunk.BifrostChatResponse != nil && chunk.BifrostChatResponse.Usage != nil {
+					terminal = true
+					if !strings.Contains(string(obj["usage"]), `"prompt_tokens":0`) || !strings.Contains(string(obj["usage"]), `"completion_tokens":0`) {
+						t.Fatal("zero usage lost")
+					}
+				}
+			}
+			if !terminal {
+				t.Fatal("missing terminal usage")
+			}
+		})
+	}
+}
+
+func TestFlashNativeStreamRejectsSuppressedDriftAndMalformedMetadata(t *testing.T) {
+	a := `,"system_fingerprint":"fp-A"`
+	b := `,"system_fingerprint":"fp-B"`
+	stableFinish := flashFrame(a, flashFinish, "")
+	stableUsage := flashFrame(a, "[]", flashUsage)
+	tests := map[string][]string{
+		"content":                 {flashFrame(a, flashContent, ""), flashFrame(b, flashContent, "")},
+		"suppressed-finish-A-B-A": {flashFrame(a, flashContent, ""), flashFrame(b, flashFinish, ""), stableUsage},
+		"suppressed-usage-A-B-A":  {flashFrame(a, flashContent, ""), stableFinish, flashFrame(b, "[]", flashUsage), stableUsage},
+		"absent":                  {flashFrame(a, flashContent, ""), flashFrame("", flashFinish, "")},
+		"null":                    {flashFrame(a, flashContent, ""), flashFrame(`,"system_fingerprint":null`, flashFinish, "")},
+	}
+	for _, field := range []string{"id", "model"} {
+
+		for _, raw := range []string{`"different"`, `null`} {
+			changedUsage := strings.Replace(stableUsage, `"`+field+`":"`+map[string]string{"id": "c", "model": "deepseek-flash"}[field]+`"`, `"`+field+`":`+raw, 1)
+			tests[field+"-usage-A-B-A-"+raw] = []string{flashFrame(a, flashContent, ""), stableFinish, changedUsage, stableUsage}
+		}
+		missingUsage := strings.Replace(stableUsage, `"`+field+`":"`+map[string]string{"id": "c", "model": "deepseek-flash"}[field]+`",`, "", 1)
+		tests[field+"-usage-missing"] = []string{flashFrame(a, flashContent, ""), stableFinish, missingUsage, stableUsage}
+		for _, raw := range []string{`null`, `1`, `false`, `[]`, `{}`, `""`, `"different"`} {
+			changed := strings.Replace(stableFinish, `"`+field+`":"`+map[string]string{"id": "c", "model": "deepseek-flash"}[field]+`"`, `"`+field+`":`+raw, 1)
+			tests[field+raw] = []string{flashFrame(a, flashContent, ""), changed, stableUsage}
+		}
+		removed := strings.Replace(stableFinish, `"`+field+`":"`+map[string]string{"id": "c", "model": "deepseek-flash"}[field]+`",`, "", 1)
+		tests[field+"-missing"] = []string{flashFrame(a, flashContent, ""), removed, stableUsage}
+		duplicate := strings.Replace(stableUsage, `"`+field+`":`, `"`+field+`":"duplicate","`+field+`":`, 1)
+		tests[field+"-duplicate"] = []string{flashFrame(a, flashContent, ""), stableFinish, duplicate}
+	}
+	for _, raw := range []string{`false`, `1`, `[]`, `{}`, `"\ud800"`} {
+		tests["fingerprint-type"+raw] = []string{flashFrame(a, flashContent, ""), flashFrame(`,"system_fingerprint":`+raw, flashFinish, "")}
+	}
+	tests["fingerprint-duplicate"] = []string{flashFrame(a, flashContent, ""), flashFrame(a+a, flashFinish, "")}
+	tests["malformed-hidden"] = []string{flashFrame(a, flashContent, ""), `{"id":"c"`, stableUsage}
+	tests["typed-decode-failure-hidden"] = []string{flashFrame(a, flashContent, ""), flashFrame(a, `false`, ""), stableUsage}
+	for name, frames := range tests {
+		t.Run(name, func(t *testing.T) {
+			chunks, hits, abandoned := runFlashMetadataStream(t, frames, true)
+			if hits != 1 || !abandoned {
+				t.Fatal("rejected upstream not abandoned or request retried")
+			}
+			failed := false
+			for _, chunk := range chunks {
+				if chunk.BifrostChatResponse != nil && chunk.BifrostChatResponse.Usage != nil {
+					t.Fatal("success terminal after drift")
+				}
+				if chunk.BifrostError != nil {
+					failed = true
+					e := chunk.BifrostError
+					if e.AllowFallbacks == nil || *e.AllowFallbacks || !e.IsBifrostError {
+						t.Fatal("error permits fallback/retry")
+					}
+					if e.Error.Message != "chat stream metadata validation failed" || e.Error.Error != nil || e.ExtraFields.RawResponse != nil || e.ExtraFields.RawRequest != nil {
+						t.Fatal("unsafe metadata error")
+					}
+				}
+			}
+			if !failed {
+				t.Fatal("drift silently suppressed")
+			}
+		})
+	}
+}

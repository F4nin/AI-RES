@@ -0,0 +1,164 @@
+package schemas
+
+import (
+	"bytes"
+	"encoding/json"
+	"github.com/bytedance/sonic"
+	"sync"
+	"testing"
+)
+
+func TestChatStreamMetadataStablePresenceAndZeroUsage(t *testing.T) {
+	for _, field := range []string{"", `,"system_fingerprint":null`, `,"system_fingerprint":"fp-A"`} {
+		t.Run(field, func(t *testing.T) {
+			raw := []byte(`{"id":"c","model":"m"` + field + `}`)
+			var tracker ChatStreamMetadataTracker
+			fact, err := tracker.Observe(raw)
+			if err != nil {
+				t.Fatal(err)
+			}
+			for i := 0; i < 3; i++ {
+				if _, err = tracker.Observe(raw); err != nil {
+					t.Fatal(err)
+				}
+			}
+			r := &BifrostChatResponse{ID: "wrong", Model: "wrong", SystemFingerprint: "wrong", Usage: &BifrostLLMUsage{}}
+			r.Usage.PreserveTokenCountZeros([]byte(`{"usage":{"prompt_tokens":0,"completion_tokens":0}}`), "usage.prompt_tokens", "usage.completion_tokens")
+			r.SetObservedChatStreamMetadata(fact)
+			wire, err := json.Marshal(BifrostStreamChunk{BifrostChatResponse: r})
+			if err != nil {
+				t.Fatal(err)
+			}
+			var obj map[string]json.RawMessage
+			if err = json.Unmarshal(wire, &obj); err != nil {
+				t.Fatal(err)
+			}
+			if string(obj["id"]) != `"c"` || string(obj["model"]) != `"m"` {
+				t.Fatal("not observed identity")
+			}
+			expected := map[string]string{"": "", `,"system_fingerprint":null`: "null", `,"system_fingerprint":"fp-A"`: `"fp-A"`}[field]
+			if string(obj["system_fingerprint"]) != expected {
+				t.Fatalf("presence not preserved: %s", wire)
+			}
+			if !bytes.Contains(obj["usage"], []byte(`"prompt_tokens":0`)) || !bytes.Contains(obj["usage"], []byte(`"completion_tokens":0`)) {
+				t.Fatalf("zero usage lost: %s", wire)
+			}
+		})
+	}
+}
+
+func TestChatStreamMetadataMalformedAndDrift(t *testing.T) {
+	first := []byte(`{"id":"c","model":"m","system_fingerprint":"fp-A"}`)
+	for _, raw := range []string{
+		`{"id":"c","model":"m","system_fingerprint":"fp-B"}`, `{"id":"c","model":"m"}`,
+		`{"id":"c","model":"m","system_fingerprint":null}`, `{"id":"c","model":"m","system_fingerprint":false}`,
+		`{"id":"c","model":"m","system_fingerprint":[]}`, `{"id":"c","model":"m","system_fingerprint":{}}`,
+		`{"id":"c","model":"m","system_fingerprint":"fp-A","system_fingerprint":"fp-A"}`,
+		`{"id":"different","model":"m","system_fingerprint":"fp-A"}`, `{"id":"c","model":"different","system_fingerprint":"fp-A"}`,
+		`{"model":"m","system_fingerprint":"fp-A"}`, `{"id":"c","system_fingerprint":"fp-A"}`,
+		`{"id":null,"model":"m"}`, `{"id":1,"model":"m"}`, `{"id":true,"model":"m"}`, `{"id":"","model":"m"}`,
+		`{"id":"c","model":null}`, `{"id":"c","model":[],"system_fingerprint":"fp-A"}`,
+		`{"id":"c","id":"c","model":"m"}`, `{"id":"c","model":"m","model":"m"}`,
+		`{"id":"c","model":"m","system_fingerprint":"\ud800"}`, `{"id":"c","model":"m"} {}`, `[]`, `null`, `{`,
+	} {
+		t.Run(raw, func(t *testing.T) {
+			var tracker ChatStreamMetadataTracker
+			if _, err := tracker.Observe(first); err != nil {
+				t.Fatal(err)
+			}
+			if _, err := tracker.Observe([]byte(raw)); err == nil {
+				t.Fatal("malformed or changed metadata accepted")
+			}
+		})
+	}
+}
+
+func TestChatStreamMetadataOwnFactLegacyAndIsolation(t *testing.T) {
+	var first ChatStreamMetadataTracker
+	fact, err := first.Observe([]byte(`{"id":"c","model":"m","system_fingerprint":"A"}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	before := &BifrostChatResponse{}
+	before.SetObservedChatStreamMetadata(fact)
+	if _, err = first.Observe([]byte(`{"id":"c","model":"m","system_fingerprint":"B"}`)); err == nil {
+		t.Fatal("drift accepted")
+	}
+	wire, err := json.Marshal(BifrostStreamChunk{BifrostChatResponse: before})
+	if err != nil || !bytes.Contains(wire, []byte(`"system_fingerprint":"A"`)) {
+		t.Fatal("prior fact mutated")
+	}
+	legacy, err := json.Marshal(BifrostStreamChunk{BifrostChatResponse: &BifrostChatResponse{SystemFingerprint: "legacy"}})
+	if err != nil || !bytes.Contains(legacy, []byte(`"system_fingerprint":"legacy"`)) {
+		t.Fatal("legacy serialization changed")
+	}
+	var wg sync.WaitGroup
+	for i := 0; i < 20; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			var own ChatStreamMetadataTracker
+			if _, e := own.Observe([]byte(`{"id":"own","model":"m","system_fingerprint":null}`)); e != nil {
+				t.Error(e)
+			}
+		}()
+	}
+	wg.Wait()
+}
+
+func TestChatStreamMetadataSonicAndMutationRefusal(t *testing.T) {
+	for _, field := range []string{"", `,"system_fingerprint":null`, `,"system_fingerprint":"fp-A"`} {
+		var tracker ChatStreamMetadataTracker
+		fact, err := tracker.Observe([]byte(`{"id":"c","model":"m"` + field + `}`))
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, change := range []string{"none", "id", "model", "fingerprint"} {
+			r := &BifrostChatResponse{}
+			r.SetObservedChatStreamMetadata(fact)
+			switch change {
+			case "id":
+				r.ID = "changed"
+			case "model":
+				r.Model = "changed"
+			case "fingerprint":
+				r.SystemFingerprint = "changed"
+			}
+			wire, err := sonic.Marshal(BifrostStreamChunk{BifrostChatResponse: r})
+			if change != "none" {
+				if err == nil {
+					t.Fatal("mutated tuple serialized")
+				}
+				continue
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			var obj map[string]json.RawMessage
+			if json.Unmarshal(wire, &obj) != nil {
+				t.Fatal("invalid sonic wire")
+			}
+			want := map[string]string{"": "", `,"system_fingerprint":null`: "null", `,"system_fingerprint":"fp-A"`: `"fp-A"`}[field]
+			if string(obj["system_fingerprint"]) != want {
+				t.Fatal("sonic lost presence")
+			}
+		}
+	}
+}
+
+func TestChatStreamMetadataMixedFamilyCannotBypassSerializer(t *testing.T) {
+	var tracker ChatStreamMetadataTracker
+	fact, err := tracker.Observe([]byte(`{"id":"c","model":"m","system_fingerprint":"A"}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	response := &BifrostChatResponse{}
+	response.SetObservedChatStreamMetadata(fact)
+	mixed := BifrostStreamChunk{BifrostChatResponse: response, BifrostTextCompletionResponse: &BifrostTextCompletionResponse{ID: "forged", Model: "forged", Object: "chat.completion.chunk"}}
+	if _, err = json.Marshal(mixed); err == nil {
+		t.Fatal("encoding/json selected unchecked family")
+	}
+	if _, err = sonic.Marshal(mixed); err == nil {
+		t.Fatal("sonic selected unchecked family")
+	}
+}

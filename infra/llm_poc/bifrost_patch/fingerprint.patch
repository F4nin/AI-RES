diff --git a/core/schemas/chat_stream_metadata.go b/core/schemas/chat_stream_metadata.go
new file mode 100644
--- /dev/null
+++ b/core/schemas/chat_stream_metadata.go
@@ -0,0 +1,194 @@
+package schemas
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"io"
+	"strconv"
+	"unicode/utf8"
+
+	"github.com/tidwall/sjson"
+)
+
+var errChatStreamMetadata = errors.New("invalid or changed chat stream metadata")
+
+// ChatStreamMetadataFact holds only observed scalar facts, never an upstream frame.
+// Its zero fingerprint state is ABSENT; NULL and VALUE remain distinct, including
+// a VALUE containing an empty string. Nothing here establishes model approval.
+type ChatStreamMetadataFact struct {
+	id                  string
+	model               string
+	fingerprintPresence uint8
+	fingerprint         string
+}
+
+// ChatStreamMetadataTracker is owned by one provider stream goroutine. Comparing
+// every raw frame before suppression prevents hidden A -> B -> A drift. A prior
+// observation is a comparison baseline, never a fill source for a missing value.
+type ChatStreamMetadataTracker struct {
+	seen   bool
+	latest ChatStreamMetadataFact
+}
+
+func (t *ChatStreamMetadataTracker) Observe(raw []byte) (ChatStreamMetadataFact, error) {
+	fact, err := parseChatStreamMetadata(raw)
+	if err != nil || (t.seen && fact != t.latest) {
+		return ChatStreamMetadataFact{}, errChatStreamMetadata
+	}
+	t.seen, t.latest = true, fact
+	return fact, nil
+}
+
+func (t *ChatStreamMetadataTracker) Latest() (ChatStreamMetadataFact, bool) { return t.latest, t.seen }
+
+// strictMetadataString rejects invalid Unicode escapes instead of encoding/json's
+// replacement-rune normalization, while treating equivalent valid JSON escapes
+// as the same observed string value.
+func strictMetadataString(raw []byte) (string, error) {
+	raw = bytes.TrimSpace(raw)
+	if len(raw) < 2 || raw[0] != '"' || raw[len(raw)-1] != '"' {
+		return "", errChatStreamMetadata
+	}
+	for i := 1; i < len(raw)-1; i++ {
+		if raw[i] != '\\' {
+			continue
+		}
+		i++
+		if i >= len(raw)-1 {
+			return "", errChatStreamMetadata
+		}
+		if raw[i] != 'u' {
+			continue
+		}
+		if i+4 >= len(raw) {
+			return "", errChatStreamMetadata
+		}
+		code, err := strconv.ParseUint(string(raw[i+1:i+5]), 16, 16)
+		if err != nil {
+			return "", errChatStreamMetadata
+		}
+		i += 4
+		if code >= 0xDC00 && code <= 0xDFFF {
+			return "", errChatStreamMetadata
+		}
+		if code >= 0xD800 && code <= 0xDBFF {
+			if i+6 >= len(raw) || raw[i+1] != '\\' || raw[i+2] != 'u' {
+				return "", errChatStreamMetadata
+			}
+			low, e := strconv.ParseUint(string(raw[i+3:i+7]), 16, 16)
+			if e != nil || low < 0xDC00 || low > 0xDFFF {
+				return "", errChatStreamMetadata
+			}
+			i += 6
+		}
+	}
+	var value string
+	if json.Unmarshal(raw, &value) != nil {
+		return "", errChatStreamMetadata
+	}
+	return value, nil
+}
+
+func parseChatStreamMetadata(raw []byte) (ChatStreamMetadataFact, error) {
+	var fact ChatStreamMetadataFact
+	if !utf8.Valid(raw) {
+		return fact, errChatStreamMetadata
+	}
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	token, err := decoder.Token()
+	if err != nil || token != json.Delim('{') {
+		return fact, errChatStreamMetadata
+	}
+	seen := map[string]bool{}
+	for decoder.More() {
+		token, err = decoder.Token()
+		if err != nil {
+			return fact, errChatStreamMetadata
+		}
+		key, ok := token.(string)
+		if !ok {
+			return fact, errChatStreamMetadata
+		}
+		var value json.RawMessage
+		if decoder.Decode(&value) != nil {
+			return fact, errChatStreamMetadata
+		}
+		if key != "id" && key != "model" && key != "system_fingerprint" {
+			continue
+		}
+		if seen[key] {
+			return fact, errChatStreamMetadata
+		}
+		seen[key] = true
+		if key == "system_fingerprint" && bytes.Equal(bytes.TrimSpace(value), []byte("null")) {
+			fact.fingerprintPresence = 1
+			continue
+		}
+		text, e := strictMetadataString(value)
+		if e != nil {
+			return fact, errChatStreamMetadata
+		}
+		switch key {
+		case "id":
+			fact.id = text
+		case "model":
+			fact.model = text
+		case "system_fingerprint":
+			fact.fingerprintPresence = 2
+			fact.fingerprint = text
+		}
+	}
+	token, err = decoder.Token()
+	if err != nil || token != json.Delim('}') {
+		return fact, errChatStreamMetadata
+	}
+	var trailing any
+	if decoder.Decode(&trailing) != io.EOF || !seen["id"] || !seen["model"] || fact.id == "" || fact.model == "" {
+		return fact, errChatStreamMetadata
+	}
+	return fact, nil
+}
+
+// SetObservedChatStreamMetadata copies this chunk's checked fact. The public
+// legacy string field remains source-compatible; native stream serialization
+// separately preserves exact ABSENT/NULL/VALUE presence.
+func (r *BifrostChatResponse) SetObservedChatStreamMetadata(fact ChatStreamMetadataFact) {
+	copy := fact
+	r.observedStreamFact = &copy
+	r.ID, r.Model, r.SystemFingerprint = fact.id, fact.model, fact.fingerprint
+}
+
+func (r *BifrostChatResponse) preserveObservedChatStreamMetadata(wire []byte) ([]byte, error) {
+	if r.observedStreamFact == nil {
+		return wire, nil
+	}
+	fact := r.observedStreamFact
+	if !r.MatchesObservedChatStreamMetadata(*fact) {
+		return nil, errChatStreamMetadata
+	}
+	switch fact.fingerprintPresence {
+	case 0:
+		return sjson.DeleteBytes(wire, "system_fingerprint")
+	case 1:
+		return sjson.SetRawBytes(wire, "system_fingerprint", []byte("null"))
+	case 2:
+		return sjson.SetBytes(wire, "system_fingerprint", fact.fingerprint)
+	default:
+		return nil, errChatStreamMetadata
+	}
+}
+
+// ObservedChatStreamMetadata snapshots the opaque fact before a converter/hook.
+func (r *BifrostChatResponse) ObservedChatStreamMetadata() (ChatStreamMetadataFact, bool) {
+	if r == nil || r.observedStreamFact == nil {
+		return ChatStreamMetadataFact{}, false
+	}
+	return *r.observedStreamFact, true
+}
+
+// MatchesObservedChatStreamMetadata rejects mutation or dropped/replaced facts;
+// it never repairs the current response using an earlier observation.
+func (r *BifrostChatResponse) MatchesObservedChatStreamMetadata(expected ChatStreamMetadataFact) bool {
+	return r != nil && r.observedStreamFact != nil && *r.observedStreamFact == expected && r.ID == expected.id && r.Model == expected.model && r.SystemFingerprint == expected.fingerprint
+}

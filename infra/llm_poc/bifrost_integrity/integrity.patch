+			path := filepath.Join(root, "config.json")
+			switch kind {
+			case "db", "wal", "shm", "unknown":
+				name := map[string]string{"db": "config.db", "wal": "config.db-wal", "shm": "config.db-shm", "unknown": "extra"}[kind]
+				if err := os.WriteFile(filepath.Join(root, name), []byte("refuse"), 0600); err != nil {
+					t.Fatal(err)
+				}
+			case "directory":
+				if err := os.Chmod(root, 0755); err != nil {
+					t.Fatal(err)
+				}
+			case "symlink":
+				if err := os.Rename(path, filepath.Join(root, "outside")); err != nil {
+					t.Fatal(err)
+				}
+				if err := os.Symlink(filepath.Join(root, "outside"), path); err != nil {
+					t.Fatal(err)
+				}
+			case "hardlink":
+				external := filepath.Join(t.TempDir(), "shared-config")
+				raw, e := os.ReadFile(path)
+				if e != nil {
+					t.Fatal(e)
+				}
+				if e = os.WriteFile(external, raw, 0600); e != nil {
+					t.Fatal(e)
+				}
+				if e = os.Remove(path); e != nil {
+					t.Fatal(e)
+				}
+				if e = os.Link(external, path); e != nil {
+					t.Fatal(e)
+				}
+			case "mode":
+				if err := os.Chmod(path, 0644); err != nil {
+					t.Fatal(err)
+				}
+			case "missing":
+				if err := os.Remove(path); err != nil {
+					t.Fatal(err)
+				}
+			case "wrong-render":
+				if err := os.WriteFile(path, []byte("{}"), 0600); err != nil {

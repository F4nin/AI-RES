+func TestCandidateSQLiteLogicalHashIsReadonlyOrderIndependentAndBounded(t *testing.T) {
+	root := t.TempDir()
+	path := filepath.Join(root, "config.db")
+	db, err := sql.Open("sqlite3", path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	if _, err = db.Exec("CREATE TABLE policy (a TEXT,b INTEGER); INSERT INTO policy VALUES ('a',1),('b',2)"); err != nil {
+		t.Fatal(err)
+	}
+	before, err := candidateSQLiteSnapshot(context.Background(), path)
+	if err != nil {
+		t.Fatal("snapshot")
+	}
+	if _, err = db.Exec("DELETE FROM policy; INSERT INTO policy VALUES ('b',2),('a',1)"); err != nil {
+		t.Fatal(err)
+	}
+	after, err := candidateSQLiteSnapshot(context.Background(), path)
+	if err != nil || before != after {
+		t.Fatal("logical row order changed hash")
+	}
+	if _, err = db.Exec("INSERT INTO policy VALUES ('x',3)"); err != nil {
+		t.Fatal(err)
+	}
+	changed, err := candidateSQLiteSnapshot(context.Background(), path)
+	if err != nil || changed == before {
+		t.Fatal("row mutation hidden")
+	}
+	if _, err = db.Exec("INSERT INTO policy VALUES (zeroblob(1048577),4)"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = candidateSQLiteSnapshot(context.Background(), path); err == nil {
+		t.Fatal("oversize field accepted")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err = candidateSQLiteSnapshot(ctx, path); err == nil {
+		t.Fatal("canceled snapshot accepted")
+	}
+}

+func TestCandidateIntegrityMutationsAreStickyAndNeverReachNext(t *testing.T) {
+	for _, kind := range []string{"rendered", "marker", "mounted", "live", "database", "schema", "missing-db", "corrupt-db"} {
+		t.Run(kind, func(t *testing.T) {

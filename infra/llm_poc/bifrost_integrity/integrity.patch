+
+// candidateIntegrity never exports secret or database values. The fixed marker
+// contains only a process nonce and the rendered-file digest; it is not approval.
+type candidateIntegrity struct {
+	mu             sync.Mutex
+	root           string
+	readInput      func(string) ([]byte, error)
+	inputs         map[string][32]byte
+	configDigest   [32]byte
+	liveDigest     [32]byte
+	databaseDigest [32]byte
+	config         *lib.Config
+	marker         []byte
+	ready          bool
+	blocked        bool
+}
+
+func candidateRegularFile(path string, exactMode os.FileMode) ([]byte, error) {
+	fd, err := syscall.Open(path, syscall.O_RDONLY|syscall.O_NOFOLLOW|syscall.O_NONBLOCK|syscall.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, errCandidateIntegrity
+	}
+	source := os.NewFile(uintptr(fd), path)
+	defer source.Close()
+	info, err := source.Stat()
+	if err != nil || !info.Mode().IsRegular() || info.Size() < 1 || info.Size() > candidateMaxFile || info.Mode().Perm()&0022 != 0 {
+		return nil, errCandidateIntegrity
+	}
+	native, ok := info.Sys().(*syscall.Stat_t)
+	if !ok || native.Nlink != 1 {
+		return nil, errCandidateIntegrity
+	}
+	if exactMode != 0 && info.Mode().Perm() != exactMode {
+		return nil, errCandidateIntegrity
+	}
+	raw, err := io.ReadAll(io.LimitReader(source, candidateMaxFile+1))
+	if err != nil || len(raw) != int(info.Size()) || len(raw) > candidateMaxFile {
+		return nil, errCandidateIntegrity
+	}
+	return raw, nil
+}
+
+func candidateRendered(inputs map[string][]byte) ([]byte, error) {
+	expected := map[string]string{
+		"/etc/bifrost/config.template.json":  candidateTemplateJSON,
+		"/etc/bifrost/pricing.json":          candidatePricingJSON,
+		"/etc/bifrost/model-parameters.json": candidateModelParametersJSON,
+		"/etc/bifrost/mcp-library.json":      candidateMCPLibraryJSON,
+	}
+	for path, raw := range expected {
+		if !bytes.Equal(inputs[path], []byte(raw)) {
+			return nil, errCandidateIntegrity
+		}
+	}
+	rendered := append([]byte(nil), inputs["/etc/bifrost/config.template.json"]...)
+	placeholders := map[string]string{"bifrost_admin_password": "$BIFROST_ADMIN_PASSWORD", "bifrost_virtual_key": "$BIFROST_VIRTUAL_KEY", "llm_relay_auth": "$LLM_RELAY_AUTH"}
+	for name, placeholder := range placeholders {
+		value := inputs["/run/secrets/"+name]
+		if len(value) == 65 && value[64] == '\n' {
+			value = value[:64]
+		}
+		if len(value) != 64 {
+			return nil, errCandidateIntegrity
+		}
+		for _, letter := range value {
+			if !(letter >= '0' && letter <= '9' || letter >= 'a' && letter <= 'f') {
+				return nil, errCandidateIntegrity
+			}
+		}
+		if bytes.Count(rendered, []byte(placeholder)) != 1 {
+			return nil, errCandidateIntegrity
+		}
+		rendered = bytes.Replace(rendered, []byte(placeholder), value, 1)
+	}
+	return rendered, nil
+}
+
+func prepareCandidateIntegrity(configDir string) (*candidateIntegrity, error) {
+	if configDir != "/app/data" {
+		return nil, errCandidateIntegrity
+	}
+	return prepareCandidateIntegrityAt(configDir, func(path string) ([]byte, error) { return candidateRegularFile(path, 0) })
+}
+
+func prepareCandidateIntegrityAt(root string, reader func(string) ([]byte, error)) (*candidateIntegrity, error) {
+	info, err := os.Lstat(root)
+	if err != nil || !info.IsDir() || info.Mode().Perm() != 0700 || info.Mode()&os.ModeSymlink != 0 {
+		return nil, errCandidateIntegrity
+	}
+	entries, err := os.ReadDir(root)
+	if err != nil || len(entries) != 1 || entries[0].Name() != "config.json" {
+		return nil, errCandidateIntegrity
+	}
+	raw, err := candidateRegularFile(filepath.Join(root, "config.json"), 0600)
+	if err != nil {
+		return nil, errCandidateIntegrity
+	}
+	inputs := make(map[string][]byte, len(candidateInputNames))
+	for _, path := range candidateInputNames {
+		value, e := reader(path)
+		if e != nil {
+			return nil, errCandidateIntegrity
+		}
+		inputs[path] = value
+	}
+	expected, err := candidateRendered(inputs)
+	if err != nil || !bytes.Equal(raw, expected) {
+		return nil, errCandidateIntegrity
+	}
+	digests := make(map[string][32]byte, len(inputs))
+	for path, value := range inputs {
+		digests[path] = sha256.Sum256(value)
+	}
+	return &candidateIntegrity{root: root, readInput: reader, inputs: digests, configDigest: sha256.Sum256(raw)}, nil
+}
+
+func candidateLiveSnapshot(config *lib.Config) ([32]byte, error) {
+	if config == nil || config.ClientConfig == nil {
+		return [32]byte{}, errCandidateIntegrity
+	}
+	config.Mu.RLock()
+	raw, err := json.Marshal(struct {
+		Client    any
+		Providers any
+		Framework any
+	}{config.ClientConfig, config.Providers, config.FrameworkConfig})
+	config.Mu.RUnlock()
+	if err != nil || len(raw) > candidateMaxSnapshot {
+		return [32]byte{}, errCandidateIntegrity
+	}
+	return sha256.Sum256(raw), nil
+}
+
+// SQLite snapshot includes ALL schema objects, ALL tables, ALL columns and ALL
+// rows. There are no bookkeeping exceptions: an unexplained change is refusal.
+// Every query runs in one readonly transaction, including WAL-visible content.
+func candidateSQLiteSnapshot(parent context.Context, path string) ([32]byte, error) {
+	original, err := os.Lstat(path)
+	if err != nil || !original.Mode().IsRegular() || original.Mode()&os.ModeSymlink != 0 {
+		return [32]byte{}, errCandidateIntegrity
+	}
+	ctx, cancel := context.WithTimeout(parent, 2*time.Second)
+	defer cancel()
+	uri := url.URL{Scheme: "file", Path: path}
+	db, err := sql.Open("sqlite3", uri.String()+"?mode=ro&_query_only=1&_busy_timeout=250")
+	if err != nil {
+		return [32]byte{}, errCandidateIntegrity
+	}
+	defer db.Close()
+	db.SetMaxOpenConns(1)
+	db.SetMaxIdleConns(0)
+	conn, err := db.Conn(ctx)
+	if err != nil {
+		return [32]byte{}, errCandidateIntegrity
+	}
+	defer conn.Close()
+	err = conn.Raw(func(raw any) error {
+		driver, ok := raw.(*sqlite3.SQLiteConn)
+		if !ok {
+			return errCandidateIntegrity
+		}
+		driver.SetLimit(sqlite3.SQLITE_LIMIT_LENGTH, candidateMaxFile)
+		driver.SetLimit(sqlite3.SQLITE_LIMIT_COLUMN, 2*candidateMaxColumns)
+		return nil
+	})
+	if err != nil {
+		return [32]byte{}, errCandidateIntegrity
+	}
+	tx, err := conn.BeginTx(ctx, &sql.TxOptions{ReadOnly: true})
+	if err != nil {
+		return [32]byte{}, errCandidateIntegrity
+	}
+	defer tx.Rollback()
+	budget := candidateSnapshotBudget{digest: sha256.New()}
+	tables, err := candidateSnapshotSchema(ctx, tx, &budget)
+	if err != nil {
+		return [32]byte{}, errCandidateIntegrity
+	}
+	for _, table := range tables {
+		if err = candidateSnapshotTable(ctx, tx, table, &budget); err != nil {
+			return [32]byte{}, errCandidateIntegrity
+		}
+	}
+	if err = tx.Commit(); err != nil {
+		return [32]byte{}, errCandidateIntegrity
+	}
+	current, err := os.Lstat(path)
+	if err != nil || !os.SameFile(original, current) {
+		return [32]byte{}, errCandidateIntegrity
+	}
+	var result [32]byte
+	copy(result[:], budget.digest.Sum(nil))
+	return result, nil
+}
+
+type candidateSnapshotBudget struct {
+	digest hash.Hash
+	bytes  int
+	rows   int
+}
+
+func (b *candidateSnapshotBudget) frame(value any) error {
+	raw, err := json.Marshal(value)
+	if err != nil || len(raw) > candidateMaxFile || b.bytes+len(raw) > candidateMaxSnapshot {
+		return errCandidateIntegrity
+	}
+	b.bytes += len(raw)
+	var prefix [8]byte
+	binary.BigEndian.PutUint64(prefix[:], uint64(len(raw)))
+	if _, err = b.digest.Write(prefix[:]); err != nil {
+		return errCandidateIntegrity
+	}
+	if _, err = b.digest.Write(raw); err != nil {
+		return errCandidateIntegrity
+	}
+	return nil
+}
+
+func candidateSnapshotSchema(ctx context.Context, tx *sql.Tx, budget *candidateSnapshotBudget) ([]string, error) {
+	// SQLite schema metadata must retain bytes as well: JSON normalizes invalid
+	// UTF-8 and Scan into string can coerce an unexpected SQLite storage class.
+	rows, err := tx.QueryContext(ctx, "SELECT type,name,tbl_name,typeof(type),typeof(name),typeof(tbl_name),typeof(sql),hex(CAST(sql AS BLOB)) FROM sqlite_schema ORDER BY type,name,tbl_name")
+	if err != nil {
+		return nil, errCandidateIntegrity
+	}
+	defer rows.Close()
+	var tables []string
+	objects := 0
+	for rows.Next() {
+		var kind, name, table, kindClass, nameClass, tableClass, definitionClass, definitionHex string
+		if err = rows.Scan(&kind, &name, &table, &kindClass, &nameClass, &tableClass, &definitionClass, &definitionHex); err != nil {
+			return nil, errCandidateIntegrity
+		}
+		if kindClass != "text" || nameClass != "text" || tableClass != "text" || (definitionClass != "text" && definitionClass != "null") {
+			return nil, errCandidateIntegrity
+		}
+		objects++
+		if objects > 2048 {
+			return nil, errCandidateIntegrity
+		}
+		frame := []string{hex.EncodeToString([]byte(kind)), hex.EncodeToString([]byte(name)), hex.EncodeToString([]byte(table)), definitionClass, definitionHex}
+		if err = budget.frame(frame); err != nil {
+			return nil, errCandidateIntegrity
+		}
+		if kind == "table" {
+			tables = append(tables, name)
+			if len(tables) > candidateMaxTables {
+				return nil, errCandidateIntegrity
+			}
+		}
+	}
+	if err = rows.Err(); err != nil {
+		return nil, errCandidateIntegrity
+	}
+	sort.Strings(tables)
+	return tables, nil
+}
+
+type candidateSQLiteValue struct {
+	Class string
+	Value string
+}
+
+func candidateStorageValue(class any, value any) (candidateSQLiteValue, error) {
+	kind, ok := class.(string)
+	if !ok {
+		return candidateSQLiteValue{}, errCandidateIntegrity
+	}
+	result := candidateSQLiteValue{Class: kind}
+	switch kind {
+	case "null":
+		if value != nil {
+			return candidateSQLiteValue{}, errCandidateIntegrity
+		}
+	case "integer":
+		number, ok := value.(int64)
+		if !ok {
+			return candidateSQLiteValue{}, errCandidateIntegrity
+		}
+		result.Value = strconv.FormatInt(number, 10)
+	case "real":
+		number, ok := value.(float64)
+		if !ok {
+			return candidateSQLiteValue{}, errCandidateIntegrity
+		}
+		result.Value = strconv.FormatUint(math.Float64bits(number), 16)
+	case "text", "blob":
+		encoded, ok := value.(string)
+		if !ok || len(encoded)%2 != 0 || len(encoded) > candidateMaxFile {
+			return candidateSQLiteValue{}, errCandidateIntegrity
+		}
+		if _, err := hex.DecodeString(encoded); err != nil {
+			return candidateSQLiteValue{}, errCandidateIntegrity
+		}
+		result.Value = encoded
+	default:
+		return candidateSQLiteValue{}, errCandidateIntegrity
+	}
+	return result, nil
+}
+
+func candidateSnapshotTable(ctx context.Context, tx *sql.Tx, table string, budget *candidateSnapshotBudget) error {
+	// Names come only from sqlite_schema; every identifier is still SQL-escaped.
+	quote := func(name string) string { return "\"" + strings.ReplaceAll(name, "\"", "\"\"") + "\"" }
+	identifier := quote(table)
+	metadata, err := tx.QueryContext(ctx, "SELECT * FROM "+identifier+" LIMIT 0")
+	if err != nil {
+		return errCandidateIntegrity
+	}
+	columns, err := metadata.Columns()
+	closeErr := metadata.Close()
+	if err != nil || closeErr != nil || len(columns) == 0 || len(columns) > candidateMaxColumns {
+		return errCandidateIntegrity
+	}
+	encodedColumns := make([]string, len(columns))
+	expressions := make([]string, 0, 2*len(columns))
+	for i, column := range columns {
+		encodedColumns[i] = hex.EncodeToString([]byte(column))
+		name := quote(column)
+		// CASE/CAST expressions have no declared BOOLEAN/DATETIME type. This keeps
+		// mattn's declared-column conversions out of the storage representation.
+		// typeof distinguishes INTEGER from REAL and TEXT from BLOB; hex keeps all
+		// TEXT/BLOB bytes, including invalid UTF-8. REAL uses exact IEEE-754 bits.
+		expressions = append(expressions, "typeof("+name+")", "CASE typeof("+name+") WHEN 'text' THEN hex(CAST("+name+" AS BLOB)) WHEN 'blob' THEN hex("+name+") WHEN 'integer' THEN CAST("+name+" AS INTEGER) WHEN 'real' THEN CAST("+name+" AS REAL) ELSE NULL END")
+	}
+	if err = budget.frame([]any{hex.EncodeToString([]byte(table)), encodedColumns}); err != nil {
+		return errCandidateIntegrity
+	}
+	rows, err := tx.QueryContext(ctx, "SELECT "+strings.Join(expressions, ",")+" FROM "+identifier)
+	if err != nil {
+		return errCandidateIntegrity
+	}
+	defer rows.Close()
+	var hashes []string
+	for rows.Next() {
+		budget.rows++
+		if budget.rows > candidateMaxRows {
+			return errCandidateIntegrity
+		}
+		scanned := make([]any, 2*len(columns))
+		pointers := make([]any, len(scanned))
+		for i := range scanned {
+			pointers[i] = &scanned[i]
+		}
+		if err = rows.Scan(pointers...); err != nil {
+			return errCandidateIntegrity
+		}
+		values := make([]candidateSQLiteValue, len(columns))
+		for i := range columns {
+			value, e := candidateStorageValue(scanned[2*i], scanned[2*i+1])
+			if e != nil {
+				return errCandidateIntegrity
+			}
+			values[i] = value
+		}
+		raw, e := json.Marshal(values)
+		if e != nil || len(raw) > candidateMaxFile || budget.bytes+len(raw) > candidateMaxSnapshot {
+			return errCandidateIntegrity
+		}
+		budget.bytes += len(raw)
+		digest := sha256.Sum256(raw)
+		hashes = append(hashes, hex.EncodeToString(digest[:]))
+	}
+	if err = rows.Err(); err != nil {
+		return errCandidateIntegrity
+	}
+	sort.Strings(hashes)
+	for _, digest := range hashes {
+		if err = budget.frame(digest); err != nil {
+			return errCandidateIntegrity
+		}
+	}
+	return nil
+}
+
+func (guard *candidateIntegrity) activate(config *lib.Config) error {
+	guard.mu.Lock()
+	defer guard.mu.Unlock()
+	if guard.ready || guard.blocked {
+		return errCandidateIntegrity
+	}
+	guard.config = config
+	live, err := candidateLiveSnapshot(config)
+	if err != nil {
+		return errCandidateIntegrity
+	}
+	database, err := candidateSQLiteSnapshot(context.Background(), filepath.Join(guard.root, "config.db"))
+	if err != nil {
+		return errCandidateIntegrity
+	}
+	nonce := make([]byte, 16)
+	if _, err = rand.Read(nonce); err != nil {
+		return errCandidateIntegrity
+	}
+	marker, err := json.Marshal(map[string]string{"version": candidateIntegrityVersion, "bootNonce": hex.EncodeToString(nonce), "configSha256": hex.EncodeToString(guard.configDigest[:])})
+	if err != nil {
+		return errCandidateIntegrity
+	}
+	target, err := os.OpenFile(filepath.Join(guard.root, "candidate-integrity.json"), os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
+	if err != nil {
+		return errCandidateIntegrity
+	}
+	n, writeErr := target.Write(marker)
+	closeErr := target.Close()
+	if writeErr != nil || closeErr != nil || n != len(marker) {
+		return errCandidateIntegrity
+	}
+	guard.liveDigest, guard.databaseDigest, guard.marker = live, database, marker
+	guard.ready = true
+	return nil
+}
+
+func (guard *candidateIntegrity) valid() bool {
+	guard.mu.Lock()
+	defer guard.mu.Unlock()
+	if !guard.ready || guard.blocked {
+		return false
+	}
+	if err := guard.check(); err != nil {
+		guard.blocked = true
+		return false
+	}
+	return true
+}
+
+func (guard *candidateIntegrity) check() error {
+	raw, err := candidateRegularFile(filepath.Join(guard.root, "config.json"), 0600)
+	if err != nil || sha256.Sum256(raw) != guard.configDigest {
+		return errCandidateIntegrity
+	}
+	marker, err := candidateRegularFile(filepath.Join(guard.root, "candidate-integrity.json"), 0600)
+	if err != nil || !bytes.Equal(marker, guard.marker) {
+		return errCandidateIntegrity
+	}
+	for path, digest := range guard.inputs {
+		value, e := guard.readInput(path)
+		if e != nil || sha256.Sum256(value) != digest {
+			return errCandidateIntegrity
+		}
+	}
+	live, err := candidateLiveSnapshot(guard.config)
+	if err != nil || live != guard.liveDigest {
+		return errCandidateIntegrity
+	}
+	database, err := candidateSQLiteSnapshot(context.Background(), filepath.Join(guard.root, "config.db"))
+	if err != nil || database != guard.databaseDigest {
+		return errCandidateIntegrity
+	}
+	return nil
+}
+
+func (guard *candidateIntegrity) wrap(next fasthttp.RequestHandler) fasthttp.RequestHandler {
+	return func(ctx *fasthttp.RequestCtx) {
+		method, uri := string(ctx.Method()), string(ctx.RequestURI())
+		if !(method == "GET" && uri == "/health" || method == "POST" && uri == "/v1/chat/completions") {
+			ctx.SetStatusCode(fasthttp.StatusForbidden)
+			ctx.SetContentType("application/json")
+			ctx.SetBodyString(`{"error":"CANDIDATE_ROUTE_REFUSED"}`)
+			return
+		}
+		if !guard.valid() {
+			ctx.SetStatusCode(fasthttp.StatusServiceUnavailable)
+			ctx.SetContentType("application/json")
+			ctx.SetBodyString(`{"error":"CANDIDATE_INTEGRITY_REFUSED"}`)
+			return
+		}
+		next(ctx)
+	}
+}

+func TestCandidateIntegrityFreshBootstrapRefusesExistingOrUnsafeState(t *testing.T) {
+	for _, kind := range []string{"db", "wal", "shm", "unknown", "directory", "symlink", "hardlink", "mode", "missing", "wrong-render", "changed-template", "bad-secret"} {
+		t.Run(kind, func(t *testing.T) {

+	"github.com/maximhq/bifrost/transports/v2/bifrost-http/lib"
+	"github.com/valyala/fasthttp"
+)
+
+const candidateIntegrityVersion = "ai-res-candidate-integrity/0.1"
+const candidateMaxFile = 1_048_576
+const candidateMaxSnapshot = 8_388_608
+const candidateMaxTables = 256
+const candidateMaxRows = 20_000
+const candidateMaxColumns = 512
+
+var errCandidateIntegrity = errors.New("candidate configuration integrity refused")
+
+var candidateInputNames = []string{
+	"/etc/bifrost/config.template.json", "/etc/bifrost/pricing.json",
+	"/etc/bifrost/model-parameters.json", "/etc/bifrost/mcp-library.json",
+	"/run/secrets/bifrost_admin_password", "/run/secrets/bifrost_virtual_key", "/run/secrets/llm_relay_auth",
+}

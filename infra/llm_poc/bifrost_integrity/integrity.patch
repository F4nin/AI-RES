+// Candidate-only transport boundary. This file is applied only by the isolated
+// integrity build, never the official image. All failures are intentionally opaque.
+package server
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"crypto/sha256"
+	"database/sql"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"errors"

+func candidateRequest(guard *candidateIntegrity, method, uri string) (int, bool) {
+	called := false
+	next := func(ctx *fasthttp.RequestCtx) { called = true; ctx.SetStatusCode(200) }
+	var ctx fasthttp.RequestCtx
+	ctx.Request.Header.SetMethod(method)
+	ctx.Request.SetRequestURI(uri)
+	guard.wrap(next)(&ctx)
+	return ctx.Response.StatusCode(), called
+}

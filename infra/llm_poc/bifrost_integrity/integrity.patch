+			databasePath := filepath.Join(root, "config.db")
+			originalDatabase, err := os.ReadFile(databasePath)
+			if err != nil {
+				t.Fatal(err)
+			}
+			originalInputs := candidateTestInputs()
+			switch kind {
+			case "rendered":
+				if err = os.WriteFile(configPath, []byte("{}"), 0600); err != nil {
+					t.Fatal(err)
+				}
+			case "marker":
+				if err = os.WriteFile(filepath.Join(root, "candidate-integrity.json"), []byte("{}"), 0600); err != nil {
+					t.Fatal(err)
+				}
+			case "mounted":
+				inputs["/etc/bifrost/pricing.json"] = []byte("{}")
+			case "live":
+				guard.config.Mu.Lock()
+				guard.config.ClientConfig.DropExcessRequests = false
+				guard.config.Mu.Unlock()
+			case "database", "schema":
+				db, e := sql.Open("sqlite3", filepath.Join(root, "config.db"))
+				if e != nil {
+					t.Fatal(e)
+				}
+				query := "UPDATE settings SET value='tampered' WHERE id=1"
+				if kind == "schema" {
+					query = "CREATE TABLE unexpected (value TEXT)"
+				}
+				_, e = db.Exec(query)
+				if e != nil {
+					t.Fatal(e)
+				}
+				if e = db.Close(); e != nil {
+					t.Fatal(e)
+				}
+			case "missing-db":
+				if err = os.Remove(filepath.Join(root, "config.db")); err != nil {
+					t.Fatal(err)
+				}
+			case "corrupt-db":
+				if err = os.WriteFile(filepath.Join(root, "config.db"), []byte("not sqlite"), 0600); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if status, called := candidateRequest(guard, "POST", "/v1/chat/completions"); status != 503 || called {
+				t.Fatal("mutation accepted")
+			}
+			if err = os.WriteFile(configPath, original, 0600); err != nil {
+				t.Fatal(err)
+			}
+			if err = os.WriteFile(filepath.Join(root, "candidate-integrity.json"), guard.marker, 0600); err != nil {
+				t.Fatal(err)
+			}
+			for name, value := range originalInputs {
+				inputs[name] = value
+			}
+			guard.config.Mu.Lock()
+			guard.config.ClientConfig.DropExcessRequests = true
+			guard.config.Mu.Unlock()

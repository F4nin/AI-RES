+func TestCandidateSQLiteSnapshotPreservesStorageClassesAndRawValues(t *testing.T) {
+	cases := []struct{ name, schema, initial, changed string }{
+		{"integer-versus-real", "CREATE TABLE policy (value)", "INSERT INTO policy VALUES (CAST(1 AS INTEGER))", "UPDATE policy SET value=CAST(1 AS REAL)"},
+		{"text-versus-blob", "CREATE TABLE policy (value)", "INSERT INTO policy VALUES ('YWJj')", "UPDATE policy SET value=X'616263'"},
+		{"declared-boolean-raw-integer", "CREATE TABLE policy (value BOOLEAN)", "INSERT INTO policy VALUES (1)", "UPDATE policy SET value=2"},
+		{"declared-datetime-raw-text", "CREATE TABLE policy (value DATETIME)", "INSERT INTO policy VALUES ('2026-11-18 10:00:00')", "UPDATE policy SET value='2026-11-18T10:00:00Z'"},
+		{"real-low-bits", "CREATE TABLE policy (value)", "INSERT INTO policy VALUES (1.0000000000000002)", "UPDATE policy SET value=1.0000000000000004"},
+		{"invalid-utf8-bytes", "CREATE TABLE policy (value)", "INSERT INTO policy VALUES (CAST(X'80' AS TEXT))", "UPDATE policy SET value=CAST(X'81' AS TEXT)"},
+	}
+	for _, item := range cases {
+		t.Run(item.name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "config.db")
+			db, err := sql.Open("sqlite3", path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer db.Close()
+			if _, err = db.Exec(item.schema + ";" + item.initial); err != nil {
+				t.Fatal(err)
+			}
+			before, err := candidateSQLiteSnapshot(context.Background(), path)
+			if err != nil {
+				t.Fatal("initial snapshot")
+			}
+			if _, err = db.Exec(item.changed); err != nil {
+				t.Fatal(err)
+			}
+			after, err := candidateSQLiteSnapshot(context.Background(), path)
+			if err != nil {
+				t.Fatal("changed snapshot")
+			}
+			if before == after {
+				t.Fatal("storage mutation hidden by lossy representation")
+			}
+		})
+	}
+}

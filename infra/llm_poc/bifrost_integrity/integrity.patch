+func TestCandidateIntegrityOnlyExactRoutesReachNext(t *testing.T) {
+	guard, _, _ := candidateTestActive(t)
+	for _, item := range []struct {
+		method, uri string
+		allow       bool
+	}{
+		{"GET", "/health", true}, {"POST", "/v1/chat/completions", true},
+		{"POST", "/api/config", false}, {"GET", "/api/config", false}, {"PUT", "/api/providers/deepseek", false},
+		{"GET", "/api/governance/virtual-keys", false}, {"POST", "/v1/chat/completions?x=1", false},
+		{"POST", "/v1/chat/completions/", false}, {"POST", "/v1//chat/completions", false},
+		{"POST", "/v1/chat/%63ompletions", false}, {"POST", "/prefix/v1/chat/completions", false},
+		{"POST", "http://host/v1/chat/completions", false}, {"HEAD", "/health", false}, {"OPTIONS", "/v1/chat/completions", false},
+		{"GET", "/health?", false}, {"POST", "/openai/v1/chat/completions", false},
+	} {
+		t.Run(item.method+item.uri, func(t *testing.T) {
+			status, called := candidateRequest(guard, item.method, item.uri)
+			if called != item.allow {
+				t.Fatalf("route allowed=%v", called)
+			}
+			if item.allow && status != 200 {
+				t.Fatal("positive route refused")
+			}
+			if !item.allow && status != 403 {
+				t.Fatal("refusal must precede downstream auth")
+			}
+		})
+	}
+}

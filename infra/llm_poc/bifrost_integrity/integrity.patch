+func TestCandidateSQLiteWALIsObservedWithoutWritingPolicy(t *testing.T) {
+	root := t.TempDir()
+	path := filepath.Join(root, "config.db")
+	db, err := sql.Open("sqlite3", path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	db.SetMaxOpenConns(1)
+	if _, err = db.Exec("PRAGMA journal_mode=WAL; CREATE TABLE policy (value TEXT); INSERT INTO policy VALUES ('original')"); err != nil {
+		t.Fatal(err)
+	}
+	before, err := candidateSQLiteSnapshot(context.Background(), path)
+	if err != nil {
+		t.Fatal("WAL snapshot")
+	}
+	bytesBefore, err := os.ReadFile(path + "-wal")
+	if err != nil {
+		t.Fatal(err)
+	}
+	again, err := candidateSQLiteSnapshot(context.Background(), path)
+	if err != nil || again != before {
+		t.Fatal("readonly repeated snapshot changed policy")
+	}
+	bytesAfter, err := os.ReadFile(path + "-wal")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if sha256.Sum256(bytesBefore) != sha256.Sum256(bytesAfter) {
+		t.Fatal("snapshot wrote WAL")
+	}
+	if _, err = db.Exec("UPDATE policy SET value='changed in WAL'"); err != nil {
+		t.Fatal(err)
+	}
+	after, err := candidateSQLiteSnapshot(context.Background(), path)
+	if err != nil || after == before {
+		t.Fatal("WAL mutation hidden")
+	}
+	missing := filepath.Join(root, "missing.db")
+	if _, err = candidateSQLiteSnapshot(context.Background(), missing); err == nil {
+		t.Fatal("missing database accepted")
+	}
+	if _, err = os.Stat(missing); !os.IsNotExist(err) {
+		t.Fatal("readonly snapshot created database")
+	}
+}

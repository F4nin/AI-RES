{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-res:internal:flash-candidate-control:0.1",
  "title": "WORKING internal candidate control protocol (ADR134)",
  "description": "Candidate PoC only. A positive claim is one committed use, never replayable dispatch authority. INVALID_USAGE/OVERRUN yield controlled non-success after accounting. No reserve/account/profile approval operation. Structural validation only: runtime additionally rejects duplicate JSON keys, invalid UTF-8, non-integer lexical representations and unsafe references; malformed usage is conservatively accounted and refused.",
  "oneOf": [
    {
      "$ref": "#/$defs/claimRequest"
    },
    {
      "$ref": "#/$defs/claimResponse"
    },
    {
      "$ref": "#/$defs/settlementRequest"
    },
    {
      "$ref": "#/$defs/settlementResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
      "minLength": 64,
      "maxLength": 64
    },
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])",
      "minLength": 36,
      "maxLength": 36
    },
    "ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])",
      "minLength": 1,
      "maxLength": 128
    },
    "claimRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "flash-candidate-control/0.1"
        },
        "codecVersion": {
          "const": "flash-candidate-body/0.1"
        },
        "templateCase": {
          "enum": [
            "TEXT",
            "JSON",
            "TOOL",
            "SSE",
            "CANCEL",
            "TIMEOUT"
          ]
        },
        "bodySha256": {
          "$ref": "#/$defs/hash"
        },
        "payloadBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "stream": {
          "type": "boolean"
        },
        "maxOutputTokens": {
          "const": 256
        }
      },
      "required": [
        "version",
        "codecVersion",
        "templateCase",
        "bodySha256",
        "payloadBytes",
        "stream",
        "maxOutputTokens"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "templateCase": {
                "enum": [
                  "SSE",
                  "CANCEL"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "stream": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "stream": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "claimResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "flash-candidate-control/0.1"
        },
        "attemptId": {
          "$ref": "#/$defs/uuid"
        },
        "requestRef": {
          "$ref": "#/$defs/ref"
        },
        "bodySha256": {
          "$ref": "#/$defs/hash"
        },
        "payloadBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "stream": {
          "type": "boolean"
        },
        "maxOutputTokens": {
          "const": 256
        }
      },
      "required": [
        "version",
        "attemptId",
        "requestRef",
        "bodySha256",
        "payloadBytes",
        "stream",
        "maxOutputTokens"
      ]
    },
    "settlementKnown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "flash-candidate-control/0.1"
        },
        "attemptId": {
          "$ref": "#/$defs/uuid"
        },
        "bodySha256": {
          "$ref": "#/$defs/hash"
        },
        "outcome": {
          "const": "KNOWN"
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "providerRequestRef": {
          "$ref": "#/$defs/ref"
        }
      },
      "required": [
        "version",
        "attemptId",
        "bodySha256",
        "outcome",
        "inputTokens",
        "outputTokens",
        "providerRequestRef"
      ]
    },
    "settlementUnknown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "flash-candidate-control/0.1"
        },
        "attemptId": {
          "$ref": "#/$defs/uuid"
        },
        "bodySha256": {
          "$ref": "#/$defs/hash"
        },
        "outcome": {
          "const": "UNKNOWN"
        },
        "reason": {
          "enum": [
            "TIMEOUT",
            "CANCEL",
            "NETWORK",
            "PROVIDER_ERROR",
            "UNTRUSTED_RESPONSE"
          ]
        }
      },
      "required": [
        "version",
        "attemptId",
        "bodySha256",
        "outcome",
        "reason"
      ]
    },
    "settlementInvalid": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "flash-candidate-control/0.1"
        },
        "attemptId": {
          "$ref": "#/$defs/uuid"
        },
        "bodySha256": {
          "$ref": "#/$defs/hash"
        },
        "outcome": {
          "const": "INVALID_USAGE"
        }
      },
      "required": [
        "version",
        "attemptId",
        "bodySha256",
        "outcome"
      ]
    },
    "settlementRequest": {
      "oneOf": [
        {
          "$ref": "#/$defs/settlementKnown"
        },
        {
          "$ref": "#/$defs/settlementUnknown"
        },
        {
          "$ref": "#/$defs/settlementInvalid"
        }
      ]
    },
    "settlementResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "flash-candidate-control/0.1"
        },
        "attemptId": {
          "$ref": "#/$defs/uuid"
        },
        "outcome": {
          "enum": [
            "KNOWN",
            "UNKNOWN"
          ]
        }
      },
      "required": [
        "version",
        "attemptId",
        "outcome"
      ]
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "CANDIDATE_CONTROL_DISABLED",
                "HTTPS_REQUIRED",
                "INVALID_REQUEST",
                "AUTHENTICATION_REQUIRED",
                "ACCESS_DENIED",
                "CANDIDATE_CONTROL_DENIED",
                "CANDIDATE_CONTROL_UNAVAILABLE"
              ]
            }
          },
          "required": [
            "code"
          ]
        }
      },
      "required": [
        "error"
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-res.local/schemas/glossary-document-v1.0.json",
  "title": "AI RES Glossary Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "glossary_version",
    "status",
    "language",
    "canonical_language",
    "terms"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "glossary_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "DRAFT",
        "PROPOSED_REVIEW_REQUIRED",
        "APPROVED"
      ]
    },
    "language": {
      "const": "ru"
    },
    "canonical_language": {
      "const": "en"
    },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://ai-res.local/schemas/glossary-entry-v1.1.json"
      },
      "uniqueItems": true
    }
  },
  "$comment": "Uniqueness of term_id/canonical_term and referential integrity of related_terms require semantic validation in addition to JSON Schema."
}
